{% extends "base.html" %}
{% block title %}Appointment Status – Alday Dental Clinic{% endblock %}

{% block content %}
<section class="page-hero">
    <h1>Check Your <span class="gold">Appointment</span></h1>
    <p>ENTER YOUR DETAILS TO VIEW YOUR BOOKING STATUS</p>
</section>

<section class="form-section scroll-reveal">
    <div style="max-width:560px;margin:0 auto;background:var(--white);border:1.5px solid var(--border);border-radius:20px;padding:50px;">
        <h2 style="font-family:'Cormorant Garamond',serif;font-size:1.8rem;font-weight:700;color:var(--dark);margin-bottom:8px;">Your <span class="gold">Status</span></h2>
        <p style="font-size:0.8rem;color:var(--text-light);margin-bottom:36px;">Enter the name and phone number you used when booking.</p>

        <div class="form-group" style="margin-bottom:18px;">
            <label>Full Name</label>
            <input type="text" id="statusName" placeholder="Juan Dela Cruz">
        </div>
        <div class="form-group" style="margin-bottom:24px;">
            <label>Phone Number</label>
            <input type="tel" id="statusPhone" placeholder="09XX-XXX-XXXX"
                maxlength="11" oninput="this.value=this.value.replace(/\D/g,'').slice(0,11)">
        </div>
        <button class="btn-submit" onclick="checkStatus()">Check Status</button>

        <div id="statusError" style="display:none;margin-top:18px;padding:14px 18px;background:#fff5f5;border:1px solid #fbb;border-radius:10px;font-size:0.82rem;color:#c0392b;">
            ⚠️ No appointment found. Please check your name and phone number.
        </div>

        <div id="statusResults" style="display:none;margin-top:24px;">
            <h3 style="font-family:'Cormorant Garamond',serif;font-size:1.2rem;font-weight:700;color:var(--dark);margin-bottom:14px;">Your Appointment(s)</h3>
            <div id="resultCards"></div>
        </div>
    </div>
</section>

<style>
.status-card {
    background: var(--white);
    border: 1.5px solid var(--border);
    border-radius: 14px;
    padding: 20px 24px;
    margin-bottom: 14px;
}
.status-badge {
    display: inline-block;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    padding: 4px 12px;
    border-radius: 999px;
    text-transform: uppercase;
}
.badge-pending  { background: #fef3cd; color: #856404; }
.badge-confirmed{ background: #d1f5e0; color: #155724; }
.badge-done     { background: #e2e3e5; color: #41464b; }
.badge-cancelled{ background: #f8d7da; color: #842029; }
.status-row {
    display: flex;
    justify-content: space-between;
    padding: 6px 0;
    border-bottom: 1px solid var(--border);
    font-size: 0.82rem;
}
.status-row:last-child { border-bottom: none; }
.status-row span:first-child { color: var(--text-light); }
.status-row span:last-child  { color: var(--dark); font-weight: 500; }
</style>

<script>
async function checkStatus() {
    const name  = document.getElementById('statusName').value.trim();
    const phone = document.getElementById('statusPhone').value.trim();
    const errBox = document.getElementById('statusError');
    const results = document.getElementById('statusResults');
    const cards   = document.getElementById('resultCards');

    errBox.style.display = 'none';
    results.style.display = 'none';
    cards.innerHTML = '';

    if (!name || !phone) {
        alert('Please enter both your name and phone number.');
        return;
    }

    try {
        const res = await fetch('/api/check-status?name=' + encodeURIComponent(name) + '&phone=' + encodeURIComponent(phone));
        const data = await res.json();

        if (!data.appointments || data.appointments.length === 0) {
            errBox.style.display = 'block';
            return;
        }

        data.appointments.forEach(appt => {
            const badge = {
                pending:   'badge-pending',
                confirmed: 'badge-confirmed',
                done:      'badge-done',
                cancelled: 'badge-cancelled',
            }[appt.status] || 'badge-pending';

            cards.innerHTML += `
            <div class="status-card">
                <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:14px;">
                    <span style="font-family:'Cormorant Garamond',serif;font-size:1.1rem;font-weight:700;color:var(--dark);">${appt.first_name} ${appt.last_name}</span>
                    <span class="status-badge ${badge}">${appt.status}</span>
                </div>
                <div class="status-row"><span>Branch</span><span>${appt.branch}</span></div>
                <div class="status-row"><span>Service</span><span>${appt.service}</span></div>
                <div class="status-row"><span>Date</span><span>${appt.date}</span></div>
                <div class="status-row"><span>Time</span><span>${appt.time}</span></div>
                ${appt.notes ? `<div class="status-row"><span>Notes</span><span>${appt.notes}</span></div>` : ''}
            </div>`;
        });

        results.style.display = 'block';
    } catch(e) {
        alert('Network error. Please try again.');
    }
}
</script>
{% endblock %}
